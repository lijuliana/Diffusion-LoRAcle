# Secrets, private mappings, scratch — NEVER commit (see WORKING_NORMS §2)
notes/
*.env
.env
**/secrets*
# Secret material only. This pattern used to be a bare **/*token* and was silently swallowing
# source files: scripts/extract_tokens.py, scripts/probe_tokens.py and anything else with "token"
# in its name were never committed. Keep the guard, exempt Python sources.
**/*token*
!**/*token*.py
!**/*tokens*.py

# Weights, caches, large artifacts — push only small structured results
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
results/**/*.safetensors
data_cache/
hf_cache/
*.npy
*.npz

# Downloaded assets / model caches — never commit (large + license-bound)
assets/
*.safetensors

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# OS
.DS_Store
notes/.env
